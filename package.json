{
  "name": "aufriends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preemulators": "npm run build",
    "emulators": "firebase emulators:start --project demo-aufriends-local --only hosting,auth,firestore,storage",
    "test:rules": "node --test --test-concurrency=1 tests/rules/firestore.rules.test.js tests/rules/storage.rules.test.js",
    "test:rules:firestore": "node --test --test-concurrency=1 tests/rules/firestore.rules.test.js",
    "test:rules:storage": "node --test --test-concurrency=1 tests/rules/storage.rules.test.js",
    "fixtures:auth": "node scripts/fixtures/admin-auth.mjs",
    "fixtures:adoptions": "node scripts/fixtures/adoptions-t09.mjs",
    "fixtures:products": "node scripts/fixtures/products-t11.mjs",
    "seed:emulators": "node scripts/seed-emulators.mjs",
    "seed:production:catalog": "node scripts/seed-production-catalog.mjs",
    "provision:production:admin": "node scripts/provision-production-admin.mjs --password-stdin",
    "deploy:media-worker": "npx --yes wrangler@4.147.0 deploy --config workers/media-api/wrangler.jsonc",
    "verify:auth": "node scripts/verify-admin-auth.mjs",
    "verify:panel": "node scripts/verify-admin-panel.mjs",
    "verify:t09": "node scripts/verify-adoptions.mjs",
    "verify:t10": "node scripts/verify-donations.mjs",
    "verify:t11": "node scripts/verify-products-cart.mjs",
    "verify:t12": "node scripts/verify-seed-emulators.mjs",
    "verify:t17": "node scripts/verify-whatsapp-checkout.mjs"
  },
  "dependencies": {
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.20.0",
    "vite": "8.3.2"
  }
}
